[Unit]
Description=GEO Weekly Tracker - batch worker daemon (CLI execution, single instance)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=geo-tracker
Group=geo-tracker
WorkingDirectory=/opt/geo-tracker-flask/backend
EnvironmentFile=/opt/geo-tracker-flask/.env

# 이 프로세스만 CLI(Claude Code/Codex/Gemini) 서브프로세스를 실행한다
# (migration_flask_postgres.md §2.3, §6 PATH 항목 참조). 아래 경로는 설치 방식에 맞춰
# 반드시 확인/수정한다:
#   - Claude Code CLI 공식 설치 스크립트(curl -fsSL https://claude.ai/install.sh | bash)는
#     기본적으로 ~/.local/bin에 설치한다 — 아래 User(geo-tracker)의 홈 디렉터리 기준.
#   - Codex/Gemini CLI를 시스템 전역 npm(-g)으로 설치했다면 보통 /usr/local/bin(NodeSource apt
#     설치 기준)에 심볼릭 링크가 생긴다. nvm으로 설치했다면 경로에 Node 버전 문자열이 포함되므로
#     (~/.nvm/versions/node/<버전>/bin) Node를 업그레이드할 때마다 이 줄도 같이 갱신해야 한다 —
#     시스템 전역 설치를 권장하는 이유(§6, 사전 확인 #4).
Environment=PATH=/home/geo-tracker/.local/bin:/usr/local/bin:/usr/bin:/bin

ExecStart=/opt/geo-tracker-flask/backend/.venv/bin/python -m app.worker.daemon
Restart=on-failure
RestartSec=5

# 정확히 1개 인스턴스만 떠야 한다(migration_flask_postgres.md §2.3) — 여러 인스턴스가 동시에
# 뜨면 같은 PENDING 잡을 중복 실행할 수 있다. systemd는 기본적으로 유닛 하나당 프로세스 하나만
# 관리하므로, 이 유닛 파일을 실수로 두 번 enable하지 않는 한 이 조건은 자연히 지켜진다.

[Install]
WantedBy=multi-user.target
