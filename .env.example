# GEO Weekly Tracker (Flask + PostgreSQL) — 환경 변수 예시
# 이 파일을 복사해 .env로 만들고 실제 값을 채운다. .env는 절대 커밋하지 않는다.
#   cp .env.example .env

# ==== App ====
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Seoul
ADMIN_API_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ==== Database (PostgreSQL 전용) ====
DATABASE_URL=postgresql+psycopg://geo:geo_dev_password@localhost:5432/geo_weekly_tracker
TEST_DATABASE_URL=postgresql+psycopg://geo:geo_dev_password@localhost:5432/geo_weekly_tracker_test

# ==== LLM 측정 배치 설정 ====
MOCK_LLM=true
REPEAT_COUNT=3
WEEKLY_BATCH_CRON=0 9 * * MON

# ==== CLI 기반 측정 ====
CLI_TIMEOUT_SEC=180
MAX_CALLS_PER_BATCH=300
CLAUDE_CODE_CONCURRENCY_LIMIT=1
CODEX_CONCURRENCY_LIMIT=1
GEMINI_CLI_CONCURRENCY_LIMIT=2
WORKER_POLL_INTERVAL_SEC=3
